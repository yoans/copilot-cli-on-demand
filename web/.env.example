# GitHub OAuth Application Credentials
# Create an OAuth app at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# Stripe API Keys
# Get your keys at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_PRICE_ID=price_your_stripe_price_id
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Session Configuration
SESSION_SECRET=your_session_secret_change_in_production

# Encryption Key for storing sensitive tokens (32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=your_32_character_encryption_key

# Railway Configuration
# Get your Railway API token at: https://railway.app/account/tokens
RAILWAY_API_TOKEN=your_railway_api_token
RAILWAY_PROJECT_ID=your_railway_project_id
RAILWAY_TEMPLATE_ID=your_railway_template_id

# Application Configuration
APP_BASE_URL=http://localhost:3000
PORT=3000

# Container Image
CONTAINER_IMAGE=ghcr.io/yoans/copilot-cli-container:latest

# Database (SQLite by default, can use PostgreSQL for Railway)
DATABASE_URL=./database.sqlite
# For Railway PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:port/database
